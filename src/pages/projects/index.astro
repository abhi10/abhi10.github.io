---
import { siteConfig } from "../../config";
import { getCollection } from "astro:content";
import BlogHeader from "../../components/BlogHeader.astro";
import "../../styles/global.css";

// Get blog posts to link related content
const posts = await getCollection("blog", ({ data }) => !data.draft);

// Extended project data with additional fields
const projects = [
  {
    name: "Chitram (చిత్రం)",
    subtitle: "Full Stack Image Hosting with AI Vision",
    description: "A production-ready image hosting service with automatic AI vision tagging. Upload images, get smart tags instantly.",
    status: "V1 Launched!",
    github: "https://github.com/abhi10/chitram",
    deepwiki: "https://deepwiki.com/abhi10/chitram",
    demo: "https://chitram.io",
    skills: ["FastAPI", "PostgreSQL", "MinIO", "Supabase Auth", "HTMX", "Docker", "Caddy", "OpenAI Vision"],
    relatedPosts: ["fastapi-supabase-integration", "chitram-test-architecture"],
    highlights: [
      "OpenAI gpt-4o-mini for automatic image tagging",
      "Background processing via Celery + Redis ($0.004/image, ~10s latency)",
      "355 comprehensive tests",
      "Pluggable auth & AI provider patterns",
      "Graceful degradation when services unavailable",
    ],
  },
  {
    name: "Gremlin",
    subtitle: "AI Risk Critic — CLI · Python Library · Dashboard",
    description: "Pre-ship risk critic that identifies breaking scenarios before code reaches production. 107 domain-specific QA patterns across security, concurrency, payments, auth, and more. Published to PyPI with CLI, programmatic API, async support, and an interactive Risk Dashboard with heatmap visualizations.",
    status: "V2 Launched!",
    github: "https://github.com/abhi10/gremlin",
    deepwiki: "",
    demo: "https://abhi10.github.io/gremlin/",
    skills: ["Python", "Claude API", "CLI", "Prompt Engineering", "GitHub Actions", "Chart.js", "GitHub Pages"],
    relatedPosts: [],
    highlights: [
      "107 curated QA patterns across 12 domains (payments, auth, concurrency, security...)",
      "90.7% tie rate with baseline Claude Sonnet in A/B evals across 54 test cases",
      "Published to PyPI (pip install gremlin-critic) — CLI + programmatic API + async",
      "Interactive Risk Dashboard applied to celery, pydantic, openclaw",
    ],
  },
  {
    name: "Civic Agents",
    subtitle: "AI Agents for Civic Infrastructure",
    description: "Building a platform for AI agents that serve civic infrastructure—pothole detection, disaster alerts, community services. Exploring how AI can help with unglamorous but critical problems.",
    status: "Idea Stage",
    github: "https://github.com/abhi10/civicagents",
    deepwiki: "",
    demo: "https://www.civicagents.ai/",
    skills: ["TypeScript", "Firebase", "Claude API"],
    relatedPosts: ["ai-for-social-impact"],
    highlights: [
      "Pothole Mapper - Crowdsourced civic infrastructure monitoring",
      "Plant Disease Detection - Offline-first vision AI for farmers",
      "Landslide Early Warning - Satellite + sensor prediction",
    ],
  },
];

// Helper to get post data by slug
function getPostBySlug(slug: string) {
  return posts.find(post => post.id === slug);
}

// Status badge colors
function getStatusColor(status: string) {
  switch (status) {
    case "Production": return "bg-green-100 text-green-800";
    case "V1 Launched!": return "bg-green-100 text-green-800";
    case "V0 Launched!": return "bg-blue-100 text-blue-800";
    case "In Progress": return "bg-amber-100 text-amber-800";
    case "In Development": return "bg-blue-100 text-blue-800";
    case "Idea Stage": return "bg-purple-100 text-purple-800";
    default: return "bg-gray-100 text-gray-800";
  }
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={`Open source projects by ${siteConfig.name}`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;1,100;1,200;1,300;1,400;1,500;1,600;1,700&display=swap"
      rel="stylesheet"
    />
    <title>Projects - {siteConfig.name}</title>
  </head>
  <body class="bg-amber-50/30">
    <BlogHeader currentPath="/projects" />

    <main class="max-w-6xl mx-auto px-6 sm:px-8 py-16 sm:py-20">
      <div class="mb-14">
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold text-gray-800 mb-4">
          Projects
        </h1>
        <div
          class="w-20 h-1 rounded-full"
          style={`background-color: ${siteConfig.accentColor}`}
        >
        </div>
        <p class="mt-6 text-lg text-gray-600">
          Open source projects and tools I'm building.
        </p>

        <!-- GitHub Contribution Graph -->
        <div class="mt-8">
          <a href="https://github.com/abhi10" target="_blank" rel="noopener noreferrer" class="block">
            <img
              src="https://ghchart.rshah.org/d97706/abhi10"
              alt="GitHub Contributions"
              class="w-full max-w-2xl rounded-lg"
            />
          </a>
          <p class="mt-2 text-sm text-gray-500">
            <a href="https://github.com/abhi10" target="_blank" rel="noopener noreferrer" class="hover:text-amber-700 transition-colors">
              View my GitHub profile →
            </a>
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {projects.map((project) => (
          <article class="bg-white rounded-2xl border border-dashed border-gray-300 p-6 sm:p-8 flex flex-col">
            <h2
              class="text-2xl font-bold mb-3"
              style={`color: ${siteConfig.accentColor}`}
            >
              {project.name}
            </h2>

            <p class="text-sm font-semibold text-gray-800 mb-4">
              <span class="text-gray-500">Status:</span> {project.status}
            </p>

            <p class="text-gray-600 leading-relaxed mb-6 flex-grow">
              {project.description}
            </p>

            <div class="space-y-2 mt-auto">
              {project.github && (
                <a
                  href={project.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="block text-amber-700 hover:text-amber-900 transition-colors"
                  style={`color: ${siteConfig.accentColor}`}
                >
                  View on GitHub →
                </a>
              )}
              {project.demo && (
                <a
                  href={project.demo}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="block text-amber-700 hover:text-amber-900 transition-colors"
                  style={`color: ${siteConfig.accentColor}`}
                >
                  Live Demo →
                </a>
              )}
              {project.deepwiki && (
                <a
                  href={project.deepwiki}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="block text-amber-700 hover:text-amber-900 transition-colors"
                  style={`color: ${siteConfig.accentColor}`}
                >
                  Ask AI about this codebase →
                </a>
              )}
              {project.relatedPosts && project.relatedPosts.length > 0 && (
                project.relatedPosts.map((slug) => {
                  const post = getPostBySlug(slug);
                  return post ? (
                    <a
                      href={`/blog/${slug}`}
                      class="block text-amber-700 hover:text-amber-900 transition-colors"
                      style={`color: ${siteConfig.accentColor}`}
                    >
                      {post.data.title} →
                    </a>
                  ) : null;
                })
              )}
            </div>
          </article>
        ))}
      </div>
    </main>

    <footer class="border-t border-amber-200/50 p-8 sm:p-10 mt-12 bg-white/50">
      <div class="max-w-6xl mx-auto text-center text-amber-700 text-sm">
        &copy; {new Date().getFullYear()}
        {siteConfig.name}. All rights reserved.
      </div>
    </footer>
  </body>
</html>
